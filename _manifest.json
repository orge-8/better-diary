{
  "manifest_version": 2,
  "id": "org.civetc.better-diary",
  "version": "1.2.6",
  "name": "better-diary 日记插件",
  "description": "两阶段生成的睡前日记：先从当天聊天里选材打分，再基于精选事件成文，强制引用聊天原话，反 AI 腔。日记只发布到QQ空间（cookie 三级来源自动获取：adapter → NapCat HTTP → 手动兜底），聊天内仅回报状态。发布前有语义闸：模型拒答/空输出/残句一律不发布。支持定时生成、白/黑名单过滤与日记存档。httpx 为可选依赖（仅发布时用），缺失时插件照常加载。升级 MaiBot 后若报「插件初始化失败」，删掉插件目录里的 config.toml 重生成即可（Host 1.2.3 起 config_version 为硬性要求）。",
  "author": {
    "name": "civetc",
    "url": "https://github.com/civetc"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/civetc/better-diary"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27"
    }
  ],
  "capabilities": [
    "send.text",
    "api.call",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_by_time",
    "message.get_by_time_in_chat",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
